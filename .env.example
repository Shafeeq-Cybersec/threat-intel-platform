# ── Threat Intel APIs ──────────────────────────────────────────────────────────

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Google Safe Browsing — https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# PhishTank — https://www.phishtank.com/api_info.php  (optional; works anonymously at lower rate limits)
PHISHTANK_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# ── AI / LLM ───────────────────────────────────────────────────────────────────

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Gmail Integration ──────────────────────────────────────────────────────────

# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
# https://console.cloud.google.com/apis/credentials  (OAuth 2.0 Client ID → Desktop app)
GMAIL_CREDENTIALS_PATH=credentials.json

# ── Alerting (Brevo) ───────────────────────────────────────────────────────────

# Brevo (formerly Sendinblue) transactional email — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Verified sender address in your Brevo account, and where alerts should go
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Send an email when a result scores at/above this (0-100)
ALERT_THRESHOLD=70

# ── App Settings ───────────────────────────────────────────────────────────────

SECRET_KEY=change-me-in-production
DATABASE_PATH=threat_intel.db
DEBUG=true

{
  "manifest_version": 3,
  "name": "Threat Intel URL Scanner",
  "version": "1.0.0",
  "description": "Scan the current page or any link for phishing and malware using your Threat Intelligence platform.",
  "permissions": ["activeTab", "tabs", "contextMenus", "storage", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan this page for threats",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
